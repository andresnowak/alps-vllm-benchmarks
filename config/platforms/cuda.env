# GH200 profile. Sourced by sbatch/serve.sbatch.
PLATFORM=cuda
#IMAGE_REF=jfrog.svc.cscs.ch/docker-group-csstaff/alps-images/vllm-cuda:alps7-dev-fd0ed5e6fe8cfc9a7be697de59d8afc0
IMAGE_REF=jfrog.svc.cscs.ch/docker-group-csstaff/alps-images/vllm-cuda:alps7-dev-106cf602a3ba7b33601ed660c909d353
EDF_REL=edf/vllm-cuda.toml
# UCCL-EP overlay: a newer uccl.ep/deep_ep than the image, built by tools/build-uccl-overlay.sh
# for exactly IMAGE_REF and put ahead of the image copy at runtime. The image keeps vLLM and
# Mooncake. Set UCCL_OVERLAY_COMMIT= (empty) to run the image's own UCCL.
UCCL_OVERLAY_COMMIT="${UCCL_OVERLAY_COMMIT-ffd90d63fea9a02c8621c0ca268f969ef173ebe1}"
UCCL_OVERLAY_ROOT="${UCCL_OVERLAY_ROOT:-/ritom/scratch/cscs/${USER}/alps-vllm-benchmarks/overlays}"
# Git patches applied to the image's packages in each job's container (scripts/runtime-patches.py),
# space-separated paths under patches/. Set RUNTIME_PATCHES= (empty) to run the image unpatched.
#  - vllm 0001: upstream #60735 (in vLLM >= 0.33), DBO + DeepEP HT illegal memory access in ep_scatter.
RUNTIME_PATCHES="${RUNTIME_PATCHES-vllm/0001-pr60735-deepep-ht-dbo-record-stream.patch}"
LOAD_FORMAT=runai_streamer
# Explicit one-time seed for this image update. The cache agent still requires
# identical Python, package, CUDA, and accelerator identities before reuse.
#JIT_CACHE_SEED_IMAGE_REFS=jfrog.svc.cscs.ch/docker-group-csstaff/alps-images/vllm-cuda:alps7-dev-42d94a4a4a128ad57fc9067fa94a5fa3
JIT_CACHE_SEED_IMAGE_REFS=jfrog.svc.cscs.ch/docker-group-csstaff/alps-images/vllm-cuda:alps7-dev-fd0ed5e6fe8cfc9a7be697de59d8afc0
