{
  "id": "uccl-ll-tp4-dbo",
  "description": "uccl-ll-tp4 with dual batch overlap: a decode step above 16 tokens splits into two micro-batches, so one's LL all-to-all overlaps the other's compute. The step budget stays at uccl-ll-tp4's 256 tokens (see there for why).",
  "constraints": {
    "exact_nodes": 4
  },
  "topology": {
    "tensor_parallel_size": 4
  },
  "server": {
    "all2all-backend": "deepep_low_latency",
    "gpu-memory-utilization": 0.9,
    "max-num-batched-tokens": 256,
    "max-num-seqs": 64,
    "enable-dbo": true,
    "dbo-decode-token-threshold": 16
  },
  "environment": {
    "FI_PROVIDER": "cxi",
    "UCCL_EP_TRANSPORT": "cxi",
    "FI_CXI_ENABLE_WRITEDATA": "1",
    "UCCL_EP_CPU_TIMEOUT_SECS": "600",
    "VLLM_DEEPEP_BUFFER_SIZE_MB": "1024"
  },
  "platform_overrides": {
    "rocm": {
      "server": {
        "kv-cache-dtype": "auto",
        "gpu-memory-utilization": 0.7,
        "enforce-eager": true
      }
    },
    "cuda": {
      "server": {
        "moe-backend": "deep_gemm"
      },
      "features": {
        "moe_backend": "deep_gemm"
      }
    }
  },
  "features": {
    "uccl_ep": "low_latency",
    "dual_batch_overlap": "decode"
  }
}
