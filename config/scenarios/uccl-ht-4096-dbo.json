{
  "id": "uccl-ht-4096-dbo",
  "description": "UCCL-EP DeepEP high-throughput with a 4096-token step budget and dual batch overlap, so one micro-batch's all-to-all overlaps the other's compute.",
  "server": {
    "all2all-backend": "deepep_high_throughput",
    "max-num-batched-tokens": 4096,
    "enable-dbo": true
  },
  "environment": {
    "FI_PROVIDER": "cxi",
    "UCCL_EP_TRANSPORT": "cxi",
    "FI_CXI_ENABLE_WRITEDATA": "1",
    "UCCL_EP_CPU_TIMEOUT_SECS": "600",
    "UCCL_EP_DISPATCH_CONFIG": "20,16,512,16,1024",
    "UCCL_EP_COMBINE_CONFIG": "20,1,512,16,512",
    "VLLM_DEEPEP_BUFFER_SIZE_MB": "1024"
  },
  "features": {
    "uccl_ep": "high_throughput",
    "dual_batch_overlap": true
  },
  "platform_overrides": {
    "cuda": {
      "server": {
        "moe-backend": "deep_gemm"
      },
      "features": {
        "moe_backend": "deep_gemm"
      }
    }
  }
}
