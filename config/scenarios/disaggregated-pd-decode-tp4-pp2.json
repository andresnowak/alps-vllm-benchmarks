{
  "id": "disaggregated-pd-decode-tp4-pp2",
  "description": "Four-node prefill (TP2 x DP8, HT, EP16) and four-node decode (TP4 x PP2 x DP2, LL, EP8: each decode replica spans two nodes, one pipeline stage per node) deployments joined by Mooncake direct KV transfer.",
  "mode": "disaggregated",
  "constraints": {
    "platforms": ["cuda"]
  },
  "features": {
    "external_kv_transfer": true,
    "disaggregated_prefill_decode": "mooncake",
    "moe_backend": "deep_gemm"
  },
  "environment": {
    "FI_PROVIDER": "cxi",
    "UCCL_EP_TRANSPORT": "cxi",
    "FI_CXI_ENABLE_WRITEDATA": "1",
    "UCCL_EP_CPU_TIMEOUT_SECS": "600",
    "UCCL_EP_DISPATCH_CONFIG": "20,16,512,16,1024",
    "UCCL_EP_COMBINE_CONFIG": "20,1,512,16,512",
    "VLLM_DEEPEP_BUFFER_SIZE_MB": "1024",
    "VLLM_MOONCAKE_CONNECTOR_TIMEOUT": "120"
  },
  "deployments": {
    "prefill": {
      "nodes": 4,
      "api_port": 8100,
      "rpc_port": 13345,
      "bootstrap_port": 8998,
      "server": {
        "all2all-backend": "deepep_high_throughput",
        "kv-transfer-config": {
          "kv_connector": "MooncakeConnector",
          "kv_role": "kv_producer",
          "kv_connector_extra_config": {
            "mooncake_protocol": "cxi"
          }
        },
        "moe-backend": "deep_gemm"
      }
    },
    "decode": {
      "nodes": 4,
      "tensor_parallel_size": 4,
      "pipeline_parallel_size": 2,
      "api_port": 8200,
      "rpc_port": 13346,
      "server": {
        "all2all-backend": "deepep_low_latency",
        "gpu-memory-utilization": 0.9,
        "max-num-seqs": 16,
        "max-num-batched-tokens": 16,
        "kv-transfer-config": {
          "kv_connector": "MooncakeConnector",
          "kv_role": "kv_consumer",
          "kv_connector_extra_config": {
            "mooncake_protocol": "cxi"
          }
        },
        "moe-backend": "deep_gemm"
      }
    },
    "proxy": {
      "port": 8000
    }
  }
}
