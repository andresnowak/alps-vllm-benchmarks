# GLM-5.3, the default model profile. Sourced by sbatch/serve.sbatch after the platform profile.
# Its server settings are in config/scenarios/baseline.json, so it has no .json layer.
MODEL_DIR=models/GLM-5.3
MODEL_CONTAINER="${MODEL_CONTAINER:-/models/GLM-5.3}"
MODEL_REPO="${MODEL_REPO:-zai-org/GLM-5.3}"
# chat: requests use /v1/chat/completions and the chat template.
MODEL_API=chat
