# Apertus2 Megachonk, a base checkpoint without a chat template (eth-cscs/alps-extended-images#67).
# Sourced by sbatch/serve.sbatch after the platform profile, so these values win.
MODEL_DIR=/capstor/store/cscs/swissai/infra01/apertus_checkpoints/v2/hf/megachonk/pretraining/iter_0088000
MODEL_CONTAINER="${MODEL_CONTAINER:-/models/megachonk}"
MODEL_REPO="${MODEL_REPO:-swiss-ai/apertus2-megachonk}"
# completions: raw /v1/completions, no chat template. Only random-token suites can run.
MODEL_API=completions
# The Apertus2 v0.31 image of #67 (swiss-ai/vllm v0.31.0+Apertus2.1), content-hashed tag with a CI "-tested" marker.
IMAGE_REF=jfrog.svc.cscs.ch/docker-group-csstaff/alps-images/vllm-apertus2-v031-cuda:alps7-dev-2890e3d63ee7891e78c7cd2962b7db86
# UCCL-EP overlay for this image: UCCL main 1c9e39bb (2026-11-21), the commit #67 moved to on
# 2026-11-24. Build it with MODEL_PROFILE=megachonk tools/build-uccl-overlay.sh.
UCCL_OVERLAY_COMMIT=1c9e39bbec2ddcd401cfe5323ee34f1fed139aac
# vllm 0001: keep DeepEP high-throughput buffers alive across DBO streams (vLLM #60735), as on cuda.env.
# vllm 0002: numa-bind binds each worker to all CPU NUMA nodes, not only its own, so online FP8
# loading can use the other CPU nodes (a bound worker was killed at ~105 GiB of ~120), not HBM.
# vllm 0003: with DBO, the second microbatch kept the first one's attention metadata (vLLM #48659).
RUNTIME_PATCHES="vllm/0001-pr60735-deepep-ht-dbo-record-stream.patch vllm/0002-numa-bind-workers-to-cpu-nodes.patch vllm/0003-pr48659-dbo-ubatch-attn-metadata-cache-key.patch"
JIT_CACHE_SEED_IMAGE_REFS=
