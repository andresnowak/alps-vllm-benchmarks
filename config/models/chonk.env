# Apertus2 Chonk, a base checkpoint without a chat template (eth-cscs/alps-extended-images#67).
# Sourced by sbatch/serve.sbatch after the platform profile, so these values win.
MODEL_DIR=/capstor/store/cscs/swissai/infra01/apertus_checkpoints/v2/hf/chonk/pretraining/long_context/long-context-iter-0003576
MODEL_CONTAINER="${MODEL_CONTAINER:-/models/chonk}"
MODEL_REPO="${MODEL_REPO:-swiss-ai/apertus2-chonk}"
# completions: raw /v1/completions, no chat template. Only random-token suites can run.
MODEL_API=completions
# The Apertus2 v0.31 image of #67 (swiss-ai/vllm v0.31.0+Apertus2.1), content-hashed tag with a CI "-tested" marker.
IMAGE_REF=jfrog.svc.cscs.ch/docker-group-csstaff/alps-images/vllm-apertus2-v031-cuda:alps7-dev-2890e3d63ee7891e78c7cd2962b7db86
# No UCCL overlay: the overlays are built for the vllm-cuda image.
UCCL_OVERLAY_COMMIT=
# vllm 0002: numa-bind binds each worker to all CPU NUMA nodes, not only its own, so online FP8
# loading can use the other CPU nodes (a bound worker was killed at ~105 GiB of ~120), not HBM.
RUNTIME_PATCHES="vllm/0002-numa-bind-workers-to-cpu-nodes.patch"
JIT_CACHE_SEED_IMAGE_REFS=
